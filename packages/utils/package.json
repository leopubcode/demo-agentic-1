{
  "name": "@repo/utils",
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "dotenv -- nodemon dist/index.cjs",
    "build": "node ./esbuild.config.js",
    "build:watch": "WATCH_MODE=true npm run build",
    "check-types": "tsc",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write \"src/**/*.ts\" --log-level warn"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.27.3",
    "nodemon": "^3.1.10",
    "typescript": "5.9.3"
  },
  "dependencies": {}
}
